{
  "name": "hypermart",
  "version": "1.0.0",
  "description": "J C Mart is a production-grade, hyperlocal quick-commerce application built with Flutter and Firebase BaaS. It features real-time inventory adjustments and Cash on Delivery (COD) fulfillment pipelines divided across three user personas: Customers, Delivery Partners, and Store Admins.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "build:web": "flutter build web",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "seed": "node scripts/seed.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "repository": {
    "type": "git",
