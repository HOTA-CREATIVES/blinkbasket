rules_version = '2';

// J C Mart / HyperMart Firestore security rules.
//
// Conventions these rules depend on:
//  - admins/{uid}        : doc ID MUST be the admin's Firebase Auth UID (whitelisted via console).
//  - deliveryBoys/{uid}  : doc ID MUST be the rider's Firebase Auth UID (created by admin).
//  - orders are created ONLY by the `placeOrder` Cloud Function (Admin SDK bypasses rules).
//  - the delivery OTP lives in orders/{id}/private/delivery, readable only by the order's customer.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // True when the caller's admins doc exists but has been deactivated. The
    // admin claim can outlive that by up to an hour, so it is not trusted alone
    // (same reasoning as riderDisabled below, and as the callables' isActive
    // checks).
    function adminDisabled() {
      let adminPath = /databases/$(database)/documents/admins/$(request.auth.uid);
      return exists(adminPath) && get(adminPath).data.get('isActive', true) == false;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true && !adminDisabled();
    }

    // A customer phone is a 10-digit Indian mobile (optionally +91-prefixed), or
    // empty on a fresh stub. Enforced when the field is written so a rider is
    // never handed an order with a number that can't be called.
    function validPhone(value) {
      return value is string && (value == '' || value.matches('^(\\+91)?[6-9][0-9]{9}$'));
    }

    // Size/shape caps on the customer-writable collections inside a user doc,
    // so a client can't bloat it toward the 1 MiB document limit.
    function userWithinLimits() {
      let d = request.resource.data;
      return (!('cart' in d) || d.cart == null || (d.cart is map && d.cart.size() <= 100))
        && (!('addresses' in d) || (d.addresses is list && d.addresses.size() <= 20))
        && (!('favoriteProductIds' in d) || (d.favoriteProductIds is list && d.favoriteProductIds.size() <= 500))
        && (!('fcmTokens' in d) || (d.fcmTokens is list && d.fcmTokens.size() <= 20));
    }

    // True when the caller's deliveryBoys doc exists but has been disabled or
    // soft-deleted by an admin. Rider "delete" is a soft delete (the doc stays),
    // and the custom claim can outlive it by up to an hour, so neither the
    // claim nor mere doc existence may be trusted on its own.
    function riderDisabled() {
      let riderPath = /databases/$(database)/documents/deliveryBoys/$(request.auth.uid);
      return exists(riderPath)
        && (get(riderPath).data.get('isActive', true) == false
            || get(riderPath).data.get('isDeleted', false) == true);
    }

    function isDelivery() {
      return signedIn()
        && (request.auth.token.delivery == true
            || exists(/databases/$(database)/documents/deliveryBoys/$(request.auth.uid)))
        && !riderDisabled();
    }

    // Customer profiles. Customers manage their own doc but can never
    // change their role or activate/deactivate themselves.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'customer'
        && request.resource.data.isActive == true
        && validPhone(request.resource.data.get('phone', ''))
        && userWithinLimits();
      allow update: if isAdmin()
        || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.isActive == resource.data.isActive
            && userWithinLimits()
            // Only checked when the number is being changed, so an older
            // profile with an odd stored value can still update other fields.
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone'])
                || validPhone(request.resource.data.get('phone', '')))
            // Customers may edit any non-privileged field except role/isActive.
            // Server-side claims (admin/delivery) are never set on this collection.
            // totalOrders/totalSpent/firstOrderCompleted are server-write
            // only (Cloud Functions, via admin SDK) — never customer-editable,
            // or a customer could self-inflate loyalty/stats fields.
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['name', 'phone', 'village', 'mandal', 'district',
                          'deliveryAvailable', 'deliveryZoneId', 'avatarUrl',
                          'notificationsEnabled', 'favoriteProductIds',
                          'fcmTokens', 'addresses', 'updatedAt',
                          'onboardingCompleted', 'onboardingStep', 'cart',
                          'uid', 'email', 'createdAt',
                          'vehicleDetails', 'vehicleNo',
                          'licenseNo', 'onDuty']));
      allow delete: if isAdmin();
    }

    // Admin whitelist. Managed exclusively from the Firebase console
    // (or a future admin-management Cloud Function).
    match /admins/{docId} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid == docId);
      allow write: if false;
    }

    // Delivery partner whitelist. Riders locate their own entry by the
    // email they authenticated with, and may only lock in their own UID.
    match /deliveryBoys/{docId} {
      allow read: if isAdmin()
        || (signedIn() && (docId == request.auth.uid || resource.data.uid == request.auth.uid));
      allow create, delete: if isAdmin();
      // uid: locked in on first login. fcmTokens: kept in sync for push
      // notifications (see PushNotificationService). onDuty: rider's own
      // availability toggle (isActive stays the admin-only enable/disable
      // flag). avatarUrl/vehicleDetails: rider's own profile self-edit —
      // identity fields (name/village/isActive/etc.) stay admin-controlled
      // EXCEPT for the safe self-edit allowlist below (name/phone/village
      // /vehicleNo/licenseNo) so the rider's Edit Profile screen actually
      // works without an admin round-trip.
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['uid', 'fcmTokens', 'onDuty', 'avatarUrl', 'vehicleDetails',
                          'name', 'phone', 'village', 'vehicleNo', 'licenseNo',
                          'updatedAt'])
            && (!('uid' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.uid == request.auth.uid)
            && request.resource.data.isActive == resource.data.isActive);
    }

    // A rider's own declined offers. Written only by rejectOrderOffer.
    match /deliveryBoys/{riderId}/rejectedOffers/{orderId} {
      allow read: if signedIn() && riderId == request.auth.uid;
      allow write: if false;
    }

    // Product catalog: browsable by any user, writable by admin only.
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.price is number
        && request.resource.data.price > 0.0
        // Optional discount: strictly positive and below the list price, so
        // the price the app displays is always one placeOrder will charge.
        && (!('discountedPrice' in request.resource.data)
            || request.resource.data.discountedPrice == null
            || (request.resource.data.discountedPrice is number
                && request.resource.data.discountedPrice > 0.0
                && request.resource.data.discountedPrice < request.resource.data.price));
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (
        isAdmin()
        || resource.data.customerId == request.auth.uid
        // Riders see an order (with the customer's phone, address and GPS pin)
        // only once they have accepted it. Before that they see the PII-free
        // /orderOffers/{orderId} copy below; claiming an order only ever
        // happens through the acceptOrder Cloud Function.
        || resource.data.deliveryBoyId == request.auth.uid
      );
      // Created only via the placeOrder Cloud Function.
      allow create: if false;
      allow delete: if false;
      allow update: if
        // Admin: cancel an open order, or hand it back to the rider pool. Never
        // anything else — in particular not 'delivered' (only verifyDeliveryOtp
        // may set that, since it also consumes stock and records the COD
        // collection) and never money/items/customer fields.
        (isAdmin()
            && resource.data.status in ['pending', 'assigned', 'picked_up', 'out_for_delivery']
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'cancelReason', 'cancelledBy', 'cancelledById',
                          'deliveryBoyId', 'deliveryBoyName', 'deliveryBoyPhone',
                          'unassignedFrom', 'updatedAt'])
            && request.resource.data.status in ['cancelled', 'pending']
            && (request.resource.data.status == 'cancelled'
                || request.resource.data.get('deliveryBoyId', null) == null))
        // Customer: cancel their own order if it is still pending or assigned.
        || (signedIn()
            && resource.data.customerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'cancelled'
            && (resource.data.status == 'pending' || resource.data.status == 'assigned'))
        // Customer: rate a delivered order once. Write-once — rejected if
        // the order already has a rating.
        || (signedIn()
            && resource.data.customerId == request.auth.uid
            && resource.data.status == 'delivered'
            && !('rating' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingComment', 'ratedAt', 'updatedAt'])
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5
            && (request.resource.data.get('ratingComment', null) == null
                || (request.resource.data.ratingComment is string
                    && request.resource.data.ratingComment.size() <= 500)))
        // Riders never write an order directly. Status changes go through the
        // advanceOrderStatus / verifyDeliveryOtp callables, which record when
        // and where each step happened and can't be skipped by a direct write.
        ;

      // Delivery OTP: the customer may re-read it; riders and admins cannot.
      match /private/{privateDoc} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid;
        allow write: if false;
      }
    }

    // PII-free view of orders that no rider has claimed yet (first name,
    // village, items, totals — no phone, street address or GPS pin). Written
    // only by the onOrderWritten trigger; riders read it to decide whether to
    // accept, and the full order becomes readable to them via acceptOrder.
    match /orderOffers/{orderId} {
      allow read: if isAdmin() || isDelivery();
      allow write: if false;
    }

    // App configuration (delivery fee, villages, categories, store status).
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Inventory logs: readable and writable by admins only.
    match /inventoryLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Home-screen promo carousel: browsable by any signed-in user, writable
    // by admin only (mirrors /products).
    match /banners/{bannerId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Customer Support & Helpdesk Tickets
    match /supportTickets/{ticketId} {
      allow read: if signedIn() && (isAdmin() || resource.data.customerId == request.auth.uid);
      // A customer may open a ticket for themselves (starting 'open') and,
      // afterwards, only touch the conversation bookkeeping — never who owns
      // the ticket or admin-controlled fields. Previously any field, including
      // customerId and status, was writable by the ticket's customer.
      allow create: if signedIn()
        && (isAdmin()
            || (request.resource.data.customerId == request.auth.uid
                && request.resource.data.status == 'open'
                && request.resource.data.keys().hasOnly([
                     'customerId', 'customerName', 'customerPhone', 'orderId',
                     'subject', 'category', 'status', 'priority', 'createdAt',
                     'updatedAt', 'lastMessage', 'unreadCustomerCount', 'unreadAdminCount'])));
      allow update: if signedIn() && (
        isAdmin()
        || (resource.data.customerId == request.auth.uid
            && request.resource.data.customerId == resource.data.customerId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'lastMessage', 'updatedAt',
                           'unreadAdminCount', 'unreadCustomerCount'])
            // Customers can resolve or reopen their own ticket, nothing else.
            && request.resource.data.status in ['open', 'resolved'])
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn() && (
          isAdmin()
          || get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.customerId == request.auth.uid
        );
        // A customer may only post as themselves. 'system' is allowed because
        // the app writes the automatic welcome message from the client when a
        // ticket is created; 'admin' is never allowed for a customer.
        allow create: if signedIn() && (
          isAdmin()
          // getAfter(): the client creates the ticket and its first message in
          // one batch, and plain get() would still see the pre-batch state
          // (no ticket yet).
          || (getAfter(/databases/$(database)/documents/supportTickets/$(ticketId)).data.customerId == request.auth.uid
              && request.resource.data.keys().hasOnly([
                   'ticketId', 'senderId', 'senderName', 'senderRole',
                   'message', 'imageUrl', 'timestamp', 'isRead'])
              && request.resource.data.message is string
              && request.resource.data.message.size() <= 2000
              && ((request.resource.data.senderRole == 'customer'
                   && request.resource.data.senderId == request.auth.uid)
                  || (request.resource.data.senderRole == 'system'
                      && request.resource.data.senderId == 'system')))
        );
        allow update, delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
